// ═══════════════════════════════════════════════════════════════
// GDPR Phase 3 — Governance models (new tables)
// ═══════════════════════════════════════════════════════════════

// GDPR — Subprocessor tracker (Article 28)
// Third parties that process personal data on our behalf + DPA status.
model Subprocessor {
  id                  String    @id @default(cuid()) @db.VarChar(255)
  name                String    @db.VarChar(200)
  purpose             String    @db.VarChar(200)
  data_categories     String[]  @default([])
  region              String?   @db.VarChar(50)
  transfer_mechanism  String?   @db.VarChar(50)
  dpa_status          String    @default("pending") @db.VarChar(30)
  dpa_signed_at       DateTime? @db.Timestamptz(6)
  dpa_expires_at      DateTime? @db.Timestamptz(6)
  dpa_url             String?
  contact_email       String?   @db.VarChar(255)
  website             String?   @db.VarChar(255)
  is_active           Boolean   @default(true)
  notes               String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([dpa_status])
  @@index([is_active])
  @@map("subprocessors")
}

// GDPR — Breach incident log (Articles 33 / 34)
// Every suspected or confirmed breach with its timeline.
model BreachIncident {
  id                        String    @id @default(cuid()) @db.VarChar(255)
  reference                 String    @unique @db.VarChar(50)
  title                     String    @db.VarChar(200)
  description               String
  severity                  String    @default("low") @db.VarChar(20)
  status                    String    @default("open") @db.VarChar(30)
  detected_at               DateTime  @db.Timestamptz(6)
  confirmed_at              DateTime? @db.Timestamptz(6)
  contained_at              DateTime? @db.Timestamptz(6)
  root_cause                String?
  affected_data_categories  String[]  @default([])
  affected_user_count       Int?
  supervisory_notified      Boolean   @default(false)
  supervisory_notified_at   DateTime? @db.Timestamptz(6)
  data_subjects_notified    Boolean   @default(false)
  data_subjects_notified_at DateTime? @db.Timestamptz(6)
  notification_method       String?   @db.VarChar(50)
  reporter_email            String    @db.VarChar(255)
  remediation_actions       String?
  lessons_learned           String?
  attachments_url           String?
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, detected_at])
  @@index([severity, detected_at])
  @@map("breach_incidents")
}

