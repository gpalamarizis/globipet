# Hashed build assets — immutable, cache forever (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ΓΙΑΤΙ ΕΦΥΓΑΝ ΤΑ /*.js ΚΑΙ /*.css
#
#   Έπιαναν ΚΑΘΕ αρχείο .js και .css στη ρίζα, όχι μόνο τα χτισμένα, και τα
#   κλείδωναν για έναν χρόνο. Τα αρχεία του Vite έχουν ήδη hash στο όνομα
#   και καλύπτονται από τον κανόνα /assets/* παραπάνω· οτιδήποτε άλλο στη
#   ρίζα δεν πρέπει να κλειδώνεται — ο service worker το έπαθε ήδη.

# Ο service worker ΔΕΝ κάνει cache.
# Το /*.js παραπάνω τον έπιανε και τον κλείδωνε για έναν χρόνο, που σημαίνει
# ότι καμία μελλοντική διόρθωση στις ειδοποιήσεις δεν θα έφτανε ποτέ σε όσους
# έχουν ήδη επισκεφθεί το site. Ο κανόνας μπαίνει ΜΕΤΑ το /*.js ώστε να
# υπερισχύει.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# ΤΟ HTML ΠΟΤΕ ΣΤΗΝ CACHE
#
#   Το index.html είναι ο κατάλογος: λέει ποια αρχεία assets ισχύουν αυτή τη
#   στιγμή. Αν αποθηκευτεί, ο browser ζητά αρχεία προηγούμενου build που δεν
#   υπάρχουν πια, και η σελίδα βγάζει λευκή οθόνη με «Failed to load module
#   script». Ακριβώς αυτό συνέβη στις 29/09.
#
#   Τα assets είναι ασφαλές να μένουν για πάντα επειδή έχουν hash στο όνομα.
#   Το HTML όχι, ποτέ.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Το manifest αλλάζει σπάνια αλλά πρέπει να μπορεί να ανανεωθεί.
/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Images — cache 30 days (filenames don't change but content might)
/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.jpeg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.avif
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

# Fonts — cache 1 year (very rarely change)
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Videos — cache 30 days (browser + Cloudflare CDN)
/videos/*
  Cache-Control: public, max-age=2592000, immutable
  CDN-Cache-Control: public, max-age=2592000
  Accept-Ranges: bytes
  Content-Type: video/mp4

# Security headers for everything else
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
